      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "join", "at": 0, "from": "b", "expect": { "allow": true } },
        { "op": "join", "at": 10, "from": "b", "expect": { "allow": true } },
        { "op": "intent", "at": 20, "from": "b", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "scroll", "y": 1 }, "expect": { "allow": true } }
      ]
    },
    {
      "name": "join asks members() and then the join ability, and respects maxParticipants",
      "host": { "identify": true, "config": true, "members": ["a", "b", "c"], "authorize": { "a": ["*"], "b": ["join"], "c": ["intent:*"] } },
      "config": { "consent": "notify", "maxParticipants": 2 },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "join", "at": 0, "from": "d", "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } },
        { "op": "join", "at": 10, "from": "c", "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } },
        { "op": "join", "at": 20, "from": "b", "expect": { "allow": true } },
        { "op": "leave", "at": 30, "from": "b", "expect": { "allow": true } },
        { "op": "join", "at": 40, "from": "b", "expect": { "allow": true } },
        { "op": "join", "at": 50, "from": "a", "expect": { "allow": true } }
      ]
    },
    {
      "name": "maxParticipants refuses the next join",
      "host": { "identify": true, "config": true, "members": ["a", "b", "c"], "authorize": { "a": ["*"], "b": ["*"], "c": ["*"] } },
      "config": { "maxParticipants": 2 },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }, { "ref": "b", "route": "/" }] },
      "steps": [
        { "op": "join", "at": 0, "from": "c", "expect": { "allow": false, "reason": "cowork.denied.full", "status": 409 } }
      ]
    },
    {
      "name": "anonymous support request: a requested session goes live on an authorised activate",
      "host": { "identify": true, "config": true, "members": ["guest:7", "rep", "other"], "authorize": { "guest:7": ["intent:*", "view:guest:7", "join"], "rep": ["activate", "join", "intent:*", "view:*", "drive"], "other": ["join"] } },
      "config": { "consent": "notify" },
      "session": { "state": "requested", "starter": "guest:7", "participants": [{ "ref": "guest:7", "route": "/help" }] },
      "steps": [
        { "op": "join", "at": 0, "from": "other", "expect": { "allow": false, "reason": "cowork.session.not-live", "status": 409 } },
        { "op": "activate", "at": 10, "from": "other", "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } },
        { "op": "activate", "at": 20, "from": "rep", "expect": { "allow": true } },
        { "op": "activate", "at": 30, "from": "rep", "expect": { "allow": false, "reason": "cowork.session.not-requested", "status": 409 } },
        { "op": "intent", "at": 40, "from": "guest:7", "envelope": { "view": "guest:7" }, "intent": { "kind": "control", "op": "grant", "target": "rep" }, "expect": { "allow": true } },
        { "op": "intent", "at": 50, "from": "rep", "envelope": { "view": "guest:7", "revision": 0 }, "intent": { "kind": "field", "handle": "order", "value": "A-1" }, "expect": { "allow": true } }
      ]
    },
    {
      "name": "consent accept also gates the activation of a request",
      "host": { "identify": true, "config": true, "members": ["guest:7", "rep"], "authorize": { "guest:7": ["*"], "rep": ["*"] } },
      "config": { "consent": "accept" },
      "session": { "state": "requested", "starter": "guest:7", "participants": [{ "ref": "guest:7", "route": "/help" }] },
      "steps": [
        { "op": "activate", "at": 0, "from": "rep", "expect": { "allow": false, "reason": "cowork.consent.pending", "status": 403 } },
        { "op": "consent", "at": 10, "from": "guest:7", "expect": { "allow": true } },
        { "op": "activate", "at": 20, "from": "rep", "expect": { "allow": true } }
      ]
    },
    {
      "name": "end needs the end ability, and an ended session refuses everything",
      "host": { "identify": true, "config": true, "members": ["a", "b", "c"], "authorize": { "a": ["*"], "b": ["intent:*", "view:b"], "c": ["*"] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }, { "ref": "b", "route": "/" }] },
      "steps": [
        { "op": "end", "at": 0, "from": "b", "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } },
        { "op": "end", "at": 10, "from": "c", "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } },
        { "op": "end", "at": 20, "from": "a", "expect": { "allow": true } },
        { "op": "intent", "at": 30, "from": "b", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "scroll", "y": 1 }, "expect": { "allow": false, "reason": "cowork.session.ended", "status": 410 } },
        { "op": "join", "at": 40, "from": "c", "expect": { "allow": false, "reason": "cowork.session.ended", "status": 410 } },
        { "op": "consent", "at": 50, "from": "a", "expect": { "allow": false, "reason": "cowork.session.ended", "status": 410 } },
        { "op": "end", "at": 60, "from": "a", "expect": { "allow": false, "reason": "cowork.session.ended", "status": 410 } }
      ]
    }
  ]
}
