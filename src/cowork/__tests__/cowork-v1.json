{
  "contract": "fancy-cowork/v1",
  "about": "Shared parity fixtures for fancy-cowork (PHP), fancy-cowork-js and the agent-integrations client engine. Byte-identical in every repo and pinned by SHA-256 in each suite. Spec: .ai/plans/human-cobrowse-and-chat.md section 11. Harness rules: `host.identify`/`host.config` false means that resolver is unbound; `host.members` null means unbound, else the refs members() answers yes for; `host.authorize` null means unbound, else ref -> ability globs (`*` is any run of characters) and a ref with no entry is refused; `host.predicates` names booleans the `when` limit criterion reads. `middleware` null is the default stack; otherwise names of defaults in order plus host entries `{host: refuse, reason, status}` (refuses whatever reaches it) and `{host: refuseKind, kind, reason, status}`. `session.participants` are already joined, each owning a view at `route` with revision 0. A step with `repeat` runs that many times, `every` ms apart from `at`. `{$repeat: s, count: n}` anywhere in an intent is s repeated n times. Every intent step's `expect` is the whole decision: allow true, or allow false with reason and status (and blockedUntil for a ranked refusal).",
  "defaults": {
    "middleware": ["membership", "authorize", "payloadSize", "sameOrigin", "masking", "limits", "revision", "control", "rateLimit", "audit"],
    "config": {
      "consent": "notify",
      "control": { "mode": "baton" },
      "routing": "server",
      "limits": { "allow": [], "deny": [], "mask": [], "viewOnly": [] },
      "rate": { "intentsPerSecond": 10, "visitsPerSecond": 1, "appPerMinute": 30, "startsPerMinute": 5 },
      "size": { "intentBytes": 8192, "appBytes": 16384 },
      "maxParticipants": 16
    }
  },
  "cases": [
    {
      "name": "default deny: nothing bound refuses an intent with the identity reason",
      "host": { "identify": false, "config": false, "members": null, "authorize": null },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 10 }, "expect": { "allow": false, "reason": "cowork.unconfigured.identity", "status": 403 } },
        { "op": "join", "at": 10, "from": "b", "expect": { "allow": false, "reason": "cowork.unconfigured.identity", "status": 403 } }
      ]
    },
    {
      "name": "default deny: identity alone is not enough, config is next",
      "host": { "identify": true, "config": false, "members": null, "authorize": null },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 10 }, "expect": { "allow": false, "reason": "cowork.unconfigured.config", "status": 403 } },
        { "op": "join", "at": 10, "from": "b", "expect": { "allow": false, "reason": "cowork.unconfigured.config", "status": 403 } }
      ]
    },
    {
      "name": "default deny: members unbound refuses with its own reason",
      "host": { "identify": true, "config": true, "members": null, "authorize": null },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 10 }, "expect": { "allow": false, "reason": "cowork.unconfigured.members", "status": 403 } },
        { "op": "join", "at": 10, "from": "b", "expect": { "allow": false, "reason": "cowork.unconfigured.members", "status": 403 } }
      ]
    },
    {
      "name": "default deny: authorize unbound refuses with its own reason",
      "host": { "identify": true, "config": true, "members": ["a", "b"], "authorize": null },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 10 }, "expect": { "allow": false, "reason": "cowork.unconfigured.authorize", "status": 403 } },
        { "op": "join", "at": 10, "from": "b", "expect": { "allow": false, "reason": "cowork.unconfigured.authorize", "status": 403 } },
        { "op": "intent", "at": 20, "from": "a", "intent": { "kind": "app", "topic": "note", "payload": {} }, "expect": { "allow": false, "reason": "cowork.unconfigured.authorize", "status": 403 } }
      ]
    },
    {
      "name": "validation runs before the session and the pipeline",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "session": { "state": "ended", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "teleport" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 10, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": -1 }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 20, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "visit" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 30, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "visit", "url": "" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 40, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "name" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 50, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "click", "handle": "" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 60, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "control", "op": "steal" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 70, "from": "a", "envelope": { "view": "a" }, "intent": { "kind": "control", "op": "grant" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 80, "from": "a", "intent": { "kind": "app", "topic": "Chat!", "payload": "x" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 90, "from": "a", "intent": { "kind": "app", "topic": "note" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 100, "from": "a", "envelope": { "revision": 0 }, "intent": { "kind": "focus", "handle": "name" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 110, "from": "a", "envelope": { "view": "a" }, "intent": { "kind": "focus", "handle": "name" }, "expect": { "allow": false, "reason": "cowork.invalid.intent", "status": 422 } },
        { "op": "intent", "at": 120, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "focus", "handle": "name" }, "expect": { "allow": false, "reason": "cowork.session.ended", "status": 410 } }
      ]
    },
    {
      "name": "a requested session refuses intents until it is live",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "session": { "state": "requested", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 5 }, "expect": { "allow": false, "reason": "cowork.session.not-live", "status": 409 } }
      ]
    },
    {
      "name": "membership: only live members send, receive or own the target view",
      "host": { "identify": true, "config": true, "members": ["a", "c"], "authorize": { "a": ["*"], "b": ["*"], "c": ["*"] } },
      "config": { "control": { "mode": "free" } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }, { "ref": "b", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "c", "envelope": { "view": "c", "revision": 0 }, "intent": { "kind": "scroll", "y": 5 }, "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } },
        { "op": "intent", "at": 10, "from": "b", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "scroll", "y": 5 }, "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } },
        { "op": "intent", "at": 20, "from": "a", "envelope": { "view": "c", "revision": 0 }, "intent": { "kind": "scroll", "y": 5 }, "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } },
        { "op": "intent", "at": 30, "from": "a", "envelope": { "to": ["c"] }, "intent": { "kind": "app", "topic": "note", "payload": 1 }, "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } },
        { "op": "intent", "at": 40, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 5 }, "expect": { "allow": true } },
        { "op": "leave", "at": 50, "from": "a", "expect": { "allow": true } },
        { "op": "intent", "at": 60, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 5 }, "expect": { "allow": false, "reason": "cowork.denied.membership", "status": 403 } }
      ]
    },
    {
      "name": "authorize asks intent:<kind>, then view:<view>, then drive for a view that is not the sender's",
      "host": { "identify": true, "config": true, "members": ["a", "b"], "authorize": { "a": ["intent:*", "view:*"], "b": ["intent:scroll", "view:b"] } },
      "config": { "control": { "mode": "free" } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }, { "ref": "b", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "b", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } },
        { "op": "intent", "at": 10, "from": "b", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "scroll", "y": 1 }, "expect": { "allow": true } },
        { "op": "intent", "at": 20, "from": "b", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 1 }, "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } },
        { "op": "intent", "at": 30, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "x" }, "expect": { "allow": true } },
        { "op": "intent", "at": 40, "from": "a", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } },
        { "op": "intent", "at": 50, "from": "b", "intent": { "kind": "app", "topic": "note", "payload": 1 }, "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } }
      ]
    },
    {
      "name": "drive granted: one person drives another's view",
      "host": { "identify": true, "config": true, "members": ["a", "b"], "authorize": { "a": ["intent:*", "view:*", "drive"], "b": ["intent:*", "view:b"] } },
      "config": { "control": { "mode": "free" } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }, { "ref": "b", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "b", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "Ada" }, "expect": { "allow": true } },
        { "op": "intent", "at": 10, "from": "b", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.authorize", "status": 403 } }
      ]
    },
    {
      "name": "payload size: 8192 bytes of intent JSON pass, 8193 do not; app payload 16384 pass, 16385 do not",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "h", "value": { "$repeat": "x", "count": 8152 } }, "expect": { "allow": true } },
        { "op": "intent", "at": 200, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "h", "value": { "$repeat": "x", "count": 8153 } }, "expect": { "allow": false, "reason": "cowork.denied.size", "status": 413 } },
        { "op": "intent", "at": 400, "from": "a", "intent": { "kind": "app", "topic": "note", "payload": { "$repeat": "x", "count": 16382 } }, "expect": { "allow": true } },
        { "op": "intent", "at": 600, "from": "a", "intent": { "kind": "app", "topic": "note", "payload": { "$repeat": "x", "count": 16383 } }, "expect": { "allow": false, "reason": "cowork.denied.size", "status": 413 } }
      ]
    },
    {
      "name": "same origin: visit takes a relative same-origin path only",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "visit", "url": "/orders/7?tab=items#top" }, "expect": { "allow": true } },
        { "op": "expectView", "view": "a", "route": "/orders/7", "revision": 1 },
        { "op": "intent", "at": 100, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "https://evil.example/" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "intent", "at": 200, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "//evil.example/x" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "intent", "at": 300, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "/\\evil.example" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "intent", "at": 400, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "javascript:alert(1)" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "intent", "at": 500, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "/a b" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "intent", "at": 600, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "next/page" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "intent", "at": 700, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "visit", "url": "/tab\there" }, "expect": { "allow": false, "reason": "cowork.denied.origin", "status": 422 } },
        { "op": "expectView", "view": "a", "route": "/orders/7", "revision": 1 }
      ]
    },
    {
      "name": "masking and view-only handles",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "config": { "limits": { "mask": ["card.*"], "viewOnly": ["terms.accept"] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "card.number", "value": "4242" }, "expect": { "allow": false, "reason": "cowork.denied.masked", "status": 403 } },
        { "op": "intent", "at": 150, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "focus", "handle": "card.number" }, "expect": { "allow": true } },
        { "op": "intent", "at": 300, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "terms.accept", "value": true }, "expect": { "allow": false, "reason": "cowork.denied.view-only", "status": 403 } },
        { "op": "intent", "at": 450, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "click", "handle": "terms.accept" }, "expect": { "allow": false, "reason": "cowork.denied.view-only", "status": 403 } },
        { "op": "intent", "at": 600, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "submit", "handle": "terms.accept" }, "expect": { "allow": false, "reason": "cowork.denied.view-only", "status": 403 } },
        { "op": "intent", "at": 750, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "focus", "handle": "terms.accept" }, "expect": { "allow": true } },
        { "op": "intent", "at": 900, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "Ada" }, "expect": { "allow": true } }
      ]
    },
    {
      "name": "limits: a deny route rule refuses intents on that route and visits to it",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "config": { "limits": { "deny": [{ "routes": ["/admin*"] }] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/admin/users" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "name", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } },
        { "op": "intent", "at": 100, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "visit", "url": "/admin" }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } },
        { "op": "intent", "at": 200, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "visit", "url": "/home" }, "expect": { "allow": true } },
        { "op": "intent", "at": 300, "from": "a", "envelope": { "view": "a", "revision": 1 }, "intent": { "kind": "field", "handle": "name", "value": "x" }, "expect": { "allow": true } }
      ]
    },
    {
      "name": "limits: an applicable allow rule must match",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "config": { "limits": { "allow": [{ "kinds": ["field", "focus"], "handles": ["doc.*"] }] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/doc/1" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "doc.title", "value": "Q3" }, "expect": { "allow": true } },
        { "op": "intent", "at": 150, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "nav.search", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } },
        { "op": "intent", "at": 300, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "click", "handle": "doc.title" }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } },
        { "op": "intent", "at": 450, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 10 }, "expect": { "allow": true } },
        { "op": "intent", "at": 525, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "anchor": "nav.top", "y": 10 }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } },
        { "op": "intent", "at": 600, "from": "a", "intent": { "kind": "app", "topic": "note", "payload": 1 }, "expect": { "allow": true } }
      ]
    },
    {
      "name": "limits: deny wins over allow, and a rule naming handles does not apply to an intent without one",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] } },
      "config": { "limits": { "allow": [{ "handles": ["doc.*"] }], "deny": [{ "handles": ["doc.secret"] }] } },
      "session": { "state": "live", "starter": "a", "participants": [{ "ref": "a", "route": "/doc/1" }] },
      "steps": [
        { "op": "intent", "at": 0, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "doc.secret", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } },
        { "op": "intent", "at": 150, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "doc.body", "value": "x" }, "expect": { "allow": true } },
        { "op": "intent", "at": 300, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "scroll", "y": 10 }, "expect": { "allow": true } },
        { "op": "intent", "at": 450, "from": "a", "envelope": { "view": "a", "revision": 0 }, "intent": { "kind": "field", "handle": "nav.search", "value": "x" }, "expect": { "allow": false, "reason": "cowork.denied.limit", "status": 403 } }
      ]
    },
    {
      "name": "limits: a when criterion asks the host predicate",
      "host": { "identify": true, "config": true, "members": ["a"], "authorize": { "a": ["*"] }, "predicates": { "afterHours": true, "readOnlyMode": false } },
